efault\&quot;: 1.0E-6\n      },\n      \&quot;dutyCycle\&quot;: {\n        \&quot;minimum\&quot;: 0.009,\n        \&quot;maximum\&quot;: 0.975\n      }\n    }\n  },\n  \&quot;peripherals\&quot;: {\n    \&quot;oscillator\&quot;: {\n      \&quot;clockSource\&quot;: \&quot;internal FRC\&quot;,\n      \&quot;inputClockFrequency\&quot;: 8000000\n    },\n    \&quot;adc\&quot;: {\n      \&quot;current\&quot;: {\n        \&quot;a\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN1\&quot;,\n          \&quot;inverted\&quot;: true,\n          \&quot;signed\&quot;: true\n        },\n        \&quot;b\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN4\&quot;,\n          \&quot;inverted\&quot;: true,\n          \&quot;signed\&quot;: true\n        },\n        \&quot;dcLink\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN0\&quot;,\n          \&quot;inverted\&quot;: false,\n          \&quot;signed\&quot;: true\n        }\n      },\n      \&quot;voltage\&quot;: {\n        \&quot;dcLink\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN12\&quot;,\n          \&quot;signed\&quot;: true\n        },\n        \&quot;a\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN11\&quot;,\n          \&quot;signed\&quot;: false\n        },\n        \&quot;b\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN10\&quot;,\n          \&quot;signed\&quot;: false\n        },\n        \&quot;c\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN2\&quot;,\n          \&quot;signed\&quot;: false\n        }\n      },\n      \&quot;other\&quot;: {\n        \&quot;potentiometer\&quot;: {\n          \&quot;channel\&quot;: \&quot;AN15\&quot;,\n          \&quot;signed\&quot;: true\n        }\n      },\n      \&quot;samplingTime\&quot;: {\n        \&quot;default\&quot;: 3.0E-7,\n        \&quot;minimum\&quot;: 3.0E-7,\n        \&quot;maximum\&quot;: 3.0E-7\n      }\n    },\n    \&quot;pwm\&quot;: {\n      \&quot;polarity\&quot;: {\n        \&quot;upper\&quot;: \&quot;active-high\&quot;,\n        \&qu